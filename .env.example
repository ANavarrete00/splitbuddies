
# Port Split Buddies listens on inside the container.
APP_PORT=3000

# Port published on the host.
HOST_PORT=5274

# Host interface used for the published port.
# Use 127.0.0.1 when a reverse proxy on the same host
# should be the only service connecting to Split Buddies.
# Use 0.0.0.0 to expose it on all host interfaces.
BIND_ADDRESS=0.0.0.0

# Login rate limit: maximum attempts per time window.
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute

# Registration rate limit: maximum attempts per time window.
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW=1 hour
